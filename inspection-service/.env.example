# Copy this file to .env and fill in real values. The .env file is git-ignored.
# IMPORTANT: JWT_SECRET must be identical to the one in user-service/.env.

DATABASE_URI=jdbc:postgresql://your-db-host:5435/inspection_db
DATABASE_USERNAME=your_db_username
DATABASE_PASSWORD=your_db_password
JWT_SECRET=generate-a-64-hex-char-secret
KAFKA_BOOTSTRAP_SERVERS=localhost:9093
